// ============================================================
// LAB03 - Plataforma de Cursos Online
// Schema Prisma gerado a partir do modelo de dados do estudo de caso
// ============================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

// ------------------------------------------------------------
// Core
// ------------------------------------------------------------

model Usuario {
  idUsuario    Int      @id @default(autoincrement()) @map("ID_Usuario")
  nomeCompleto String   @map("NomeCompleto")
  email        String   @unique @map("Email")
  senhaHash    String   @map("SenhaHash")
  dataCadastro DateTime @default(now()) @map("DataCadastro")

  cursosMinistrados Curso[]         @relation("InstrutorCursos")
  matriculas        Matricula[]
  progressoAulas    ProgressoAula[]
  avaliacoes        Avaliacao[]
  certificados      Certificado[]
  assinaturas       Assinatura[]

  @@map("Usuarios")
}

model Categoria {
  idCategoria Int     @id @default(autoincrement()) @map("ID_Categoria")
  nome        String  @unique @map("Nome")
  descricao   String? @map("Descricao")

  cursos  Curso[]
  trilhas Trilha[]

  @@map("Categorias")
}

// ------------------------------------------------------------
// Conteúdo
// ------------------------------------------------------------

model Curso {
  idCurso        Int       @id @default(autoincrement()) @map("ID_Curso")
  titulo         String    @map("Titulo")
  descricao      String?   @map("Descricao")
  idInstrutor    Int       @map("ID_Instrutor")
  idCategoria    Int       @map("ID_Categoria")
  nivel          String?   @map("Nivel")
  dataPublicacao DateTime? @map("DataPublicacao")
  totalAulas     Int?      @map("TotalAulas")
  totalHoras     Int?      @map("TotalHoras")

  instrutor     Usuario       @relation("InstrutorCursos", fields: [idInstrutor], references: [idUsuario])
  categoria     Categoria     @relation(fields: [idCategoria], references: [idCategoria])
  modulos       Modulo[]
  matriculas    Matricula[]
  avaliacoes    Avaliacao[]
  certificados  Certificado[]
  trilhasCursos TrilhaCurso[]

  @@map("Cursos")
}

model Modulo {
  idModulo Int    @id @default(autoincrement()) @map("ID_Modulo")
  idCurso  Int    @map("ID_Curso")
  titulo   String @map("Titulo")
  ordem    Int    @map("Ordem")

  curso Curso  @relation(fields: [idCurso], references: [idCurso])
  aulas Aula[]

  @@map("Modulos")
}

model Aula {
  idAula         Int     @id @default(autoincrement()) @map("ID_Aula")
  idModulo       Int     @map("ID_Modulo")
  titulo         String  @map("Titulo")
  tipoConteudo   String  @map("TipoConteudo") // Ex: Video, Texto, Quiz
  urlConteudo    String? @map("URL_Conteudo")
  duracaoMinutos Int?    @map("DuracaoMinutos")
  ordem          Int     @map("Ordem")

  modulo         Modulo          @relation(fields: [idModulo], references: [idModulo])
  progressoAulas ProgressoAula[]

  @@map("Aulas")
}

// ------------------------------------------------------------
// Interação
// ------------------------------------------------------------

model Matricula {
  idMatricula   Int       @id @default(autoincrement()) @map("ID_Matricula")
  idUsuario     Int       @map("ID_Usuario")
  idCurso       Int       @map("ID_Curso")
  dataMatricula DateTime  @default(now()) @map("DataMatricula")
  dataConclusao DateTime? @map("DataConclusao")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  curso   Curso   @relation(fields: [idCurso], references: [idCurso])

  @@map("Matriculas")
}

model ProgressoAula {
  idUsuario     Int      @map("ID_Usuario")
  idAula        Int      @map("ID_Aula")
  dataConclusao DateTime @map("DataConclusao")
  status        String   @map("Status") // Ex: Concluido

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  aula    Aula    @relation(fields: [idAula], references: [idAula])

  @@id([idUsuario, idAula])
  @@map("Progresso_Aulas")
}

model Avaliacao {
  idAvaliacao   Int      @id @default(autoincrement()) @map("ID_Avaliacao")
  idUsuario     Int      @map("ID_Usuario")
  idCurso       Int      @map("ID_Curso")
  nota          Int      @map("Nota") // 1 a 5
  comentario    String?  @map("Comentario")
  dataAvaliacao DateTime @default(now()) @map("DataAvaliacao")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  curso   Curso   @relation(fields: [idCurso], references: [idCurso])

  @@map("Avaliacoes")
}

// ------------------------------------------------------------
// Curadoria
// ------------------------------------------------------------

model Trilha {
  idTrilha    Int     @id @default(autoincrement()) @map("ID_Trilha")
  titulo      String  @map("Titulo")
  descricao   String? @map("Descricao")
  idCategoria Int     @map("ID_Categoria")

  categoria     Categoria     @relation(fields: [idCategoria], references: [idCategoria])
  trilhasCursos TrilhaCurso[]
  certificados  Certificado[]

  @@map("Trilhas")
}

model TrilhaCurso {
  idTrilha Int @map("ID_Trilha")
  idCurso  Int @map("ID_Curso")
  ordem    Int @map("Ordem")

  trilha Trilha @relation(fields: [idTrilha], references: [idTrilha])
  curso  Curso  @relation(fields: [idCurso], references: [idCurso])

  @@id([idTrilha, idCurso])
  @@map("Trilhas_Cursos")
}

model Certificado {
  idCertificado     Int      @id @default(autoincrement()) @map("ID_Certificado")
  idUsuario         Int      @map("ID_Usuario")
  idCurso           Int      @map("ID_Curso")
  idTrilha          Int?     @map("ID_Trilha")
  codigoVerificacao String   @unique @map("CodigoVerificacao")
  dataEmissao       DateTime @default(now()) @map("DataEmissao")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  curso   Curso   @relation(fields: [idCurso], references: [idCurso])
  trilha  Trilha? @relation(fields: [idTrilha], references: [idTrilha])

  @@map("Certificados")
}

// ------------------------------------------------------------
// Negócio
// ------------------------------------------------------------

model Plano {
  idPlano      Int     @id @default(autoincrement()) @map("ID_Plano")
  nome         String  @map("Nome")
  descricao    String? @map("Descricao")
  preco        Decimal @map("Preco")
  duracaoMeses Int     @map("DuracaoMeses")

  assinaturas Assinatura[]

  @@map("Planos")
}

model Assinatura {
  idAssinatura Int      @id @default(autoincrement()) @map("ID_Assinatura")
  idUsuario    Int      @map("ID_Usuario")
  idPlano      Int      @map("ID_Plano")
  dataInicio   DateTime @map("DataInicio")
  dataFim      DateTime @map("DataFim")

  usuario    Usuario     @relation(fields: [idUsuario], references: [idUsuario])
  plano      Plano       @relation(fields: [idPlano], references: [idPlano])
  pagamentos Pagamento[]

  @@map("Assinaturas")
}

model Pagamento {
  idPagamento        Int      @id @default(autoincrement()) @map("ID_Pagamento")
  idAssinatura       Int      @map("ID_Assinatura")
  valorPago          Decimal  @map("ValorPago") // valor efetivo pago (não é FK, apesar do enunciado)
  dataPagamento      DateTime @default(now()) @map("DataPagamento")
  metodoPagamento    String   @map("MetodoPagamento")
  idTransacaoGateway String   @map("Id_Transacao_Gateway")

  assinatura Assinatura @relation(fields: [idAssinatura], references: [idAssinatura])

  @@map("Pagamentos")
}
